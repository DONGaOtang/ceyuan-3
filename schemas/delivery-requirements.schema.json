{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Ceyuan3 delivery requirements",
  "type": "object",
  "required": [
    "facts",
    "artifact_ids"
  ],
  "properties": {
    "facts": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "required": [
          "value",
          "source",
          "modules"
        ],
        "properties": {
          "value": {},
          "source": {
            "type": "string",
            "minLength": 1
          },
          "modules": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "evidence_locations": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "artifact_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "verification_result": {
            "enum": [
              "pass",
              "fail",
              "unknown"
            ]
          }
        }
      }
    },
    "artifact_ids": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "coverage_review": {
      "type": "object",
      "description": "Independent original-input coverage review; self-reported evidence, not automatic semantic validation.",
      "required": [
        "reviewer",
        "method",
        "source_inventory",
        "result"
      ],
      "properties": {
        "reviewer": {
          "type": "string",
          "minLength": 1
        },
        "method": {
          "type": "string",
          "minLength": 1
        },
        "source_inventory": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "result": {
          "enum": [
            "pass",
            "fail",
            "unknown"
          ]
        }
      }
    }
  }
}
